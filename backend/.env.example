# Copy to backend/.env and fill in REAL keys (not placeholders).
# Restart the API after any change: uvicorn app.main:app --reload --port 8000
#
# Get keys from:
#   Gemini:     https://aistudio.google.com/apikey   (usually starts with AIza)
#   OpenRouter: https://openrouter.ai/keys           (usually starts with sk-or-v1-)
#
# Leave a key blank if unused. Do NOT keep "your_..._here" placeholders.

# --- LLM providers ---
# Primary: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_VISION_MODEL=gemini-2.0-flash

# Fallback / alternative: OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# Prefer gemini | openrouter | auto
LLM_PROVIDER=auto

# --- Paths (relative to backend/ by default) ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
QDRANT_PATH=./data/qdrant
SQLITE_PATH=./data/cdss.db
SAMPLE_DATA_DIR=./data/sample

# --- Retrieval ---
QDRANT_COLLECTION=medical_kb
HYBRID_TOP_K=12
RRF_K=60
ENABLE_RERANK=false
AGENTIC_MAX_STEPS=3
AGENTIC_WALL_CLOCK_SEC=45
AGENTIC_WEAK_HIT_THRESHOLD=0.25

# --- Whisper (CPU) ---
WHISPER_MODEL=tiny
WHISPER_ENABLED=true

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
